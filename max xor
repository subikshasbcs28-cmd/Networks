#include <stdlib.h>

// Define Trie Node structure
typedef struct TrieNode {
    struct TrieNode* children[2];
} TrieNode;

// Helper function to create a new Trie Node
TrieNode* createNode() {
    TrieNode* node = (TrieNode*)calloc(1, sizeof(TrieNode));
    return node;
}

// Insert a number into the Trie bit by bit (from MSB to LSB)
void insert(TrieNode* root, int num) {
    TrieNode* curr = root;
    for (int i = 30; i >= 0; i--) {
        int bit = (num >> i) & 1;
        if (!curr->children[bit]) {
            curr->children[bit] = createNode();
        }
        curr = curr->children[bit];
    }
}

// Find the maximum XOR possible for a given number using the Trie
int getMaxXOR(TrieNode* root, int num) {
    TrieNode* curr = root;
    int maxXOR = 0;
    for (int i = 30; i >= 0; i--) {
        int bit = (num >> i) & 1;
        int toggledBit = 1 - bit; // We want the opposite bit to get a 1 in XOR

        // If the opposite bit exists, take it to maximize XOR
        if (curr->children[toggledBit]) {
            maxXOR |= (1 << i);
            curr = curr->children[toggledBit];
        } else {
            curr = curr->children[bit];
        }
    }
    return maxXOR;
}

// Free memory allocated for the Trie
void freeTrie(TrieNode* root) {
    if (!root) return;
    freeTrie(root->children[0]);
    freeTrie(root->children[1]);
    free(root);
}

int findMaximumXOR(int* nums, int numsSize) {
    if (numsSize < 2) return 0;

    TrieNode* root = createNode();
    int globalMaxXOR = 0;

    // Insert the first number into the Trie
    insert(root, nums[0]);

    // For every subsequent number, find its max XOR with existing elements, then insert it
    for (int i = 1; i < numsSize; i++) {
        int currentMax = getMaxXOR(root, nums[i]);
        if (currentMax > globalMaxXOR) {
            globalMaxXOR = currentMax;
        }
        insert(root, nums[i]);
    }

    freeTrie(root);
    return globalMaxXOR;
}
